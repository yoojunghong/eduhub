{
  "permissions": {
    "allow": [
      "Bash(./gradlew test)",
      "Bash(./gradlew test *)",
      "Bash(./gradlew spotlessApply)",
      "Bash(./gradlew spotlessApply *)",
      "Bash(./gradlew build)",
      "Bash(cd backend && ./gradlew test)",
      "Bash(cd backend && ./gradlew test *)",
      "Bash(cd backend && ./gradlew spotlessApply)",
      "Bash(cd backend && ./gradlew spotlessApply *)",
      "Bash(npm test *)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck *)",
      "Bash(npm run generate:api)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(docker *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./backend/src/main/resources/application-prod.yml)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(./gradlew flywayClean*)",
      "Bash(ssh *)",
      "Bash(psql *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-files.ps1"],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.ps1"],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PROJECT_DIR}/.claude/hooks/format.ps1"],
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-test.ps1"],
            "timeout": 300
          }
        ]
      }
    ]
  }
}
